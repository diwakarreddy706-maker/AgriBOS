{
  "name": "agribos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AgriBOS Agricultural Business Operating System - pnpm Monorepo Workspace",
  "scripts": {
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:frontend": "pnpm --filter @agribos/frontend dev",
    "dev:backend": "pnpm --filter @agribos/backend start",
    "build": "pnpm --filter @agribos/frontend build",
    "test": "pnpm --filter @agribos/backend test",
    "typecheck": "pnpm --filter @agribos/frontend typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "SRI BASAVESHWARA & CO.",
  "license": "ISC"
}
