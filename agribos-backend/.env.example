# AgriBOS Production Backend Environment Variables Configuration

# Server Environment & Port
NODE_ENV=production
PORT=8080

# PostgreSQL Production Database Connection String
# On Render / Supabase / Cloud SQL:
DATABASE_URL=postgres://agribos_user:secure_password@dpg-host.render.com:5432/agribos_db

# Local SQLite Fallback (Optional, used if DATABASE_URL is omitted)
DB_PATH=./data/agribos.db

# JWT Security
# Generate a strong 256-bit random string for production
JWT_SECRET=your_production_jwt_secret_change_me_in_render_dashboard

# CORS Security
# URL of the deployed frontend static site
FRONTEND_URL=https://agribos-frontend.onrender.com
