# AgriBOS Production Backend Environment Variables Configuration

# Server Environment & Port
NODE_ENV=production
PORT=8080

# PostgreSQL Production Database Connection String (REQUIRED when NODE_ENV=production)
# Example (Neon / Render PostgreSQL):
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Local SQLite Database Path (Optional in development/test, FORBIDDEN in production)
DB_PATH=./data/agribos.db

# JWT Security
# Generate a strong 256-bit random string for production
JWT_SECRET=your_production_jwt_secret_change_me_in_render_dashboard

# CORS Security
# URL of the deployed frontend static site
FRONTEND_URL=https://agribos-frontend.onrender.com
